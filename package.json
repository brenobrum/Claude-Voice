{
  "name": "claude-voice",
  "productName": "Claude Voice",
  "version": "0.3.0",
  "description": "Talk to the Claude Code CLI with your voice (OpenAI STT + TTS)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --arm64",
    "icon": "electron build/make-icon.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.local.claude-voice",
    "productName": "Claude Voice",
    "files": [
      "src/**/*",
      "channel/**/*",
      "local-tts/server.py",
      "INSTALL-PROMPT.md",
      "package.json"
    ],
    "asarUnpack": [
      "local-tts/**"
    ],
    "afterPack": "build/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Claude Voice listens to you so your speech can be transcribed and sent to your Claude Code session.",
        "NSAppleEventsUsageDescription": "Claude Voice opens Terminal to start a Claude Code session when there isn't one to talk to."
      },
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Claude Voice"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
